{
  "name": "fusenduck-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "bench": "node tests/bench/card.bench.ts",
    "lint": "eslint .",
    "contract:check": "vitest run tests/contract"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@eslint/js": "^9",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^24.0.0",
    "eslint": "^9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8",
    "vitest": "^5.0.5"
  }
}
