{
  "name": "fusenduck-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "pnpm --filter @fusenduck/web build && vitest run --config vitest.e2e.config.ts",
    "bench": "node tests/bench/card.bench.ts",
    "lint": "eslint .",
    "contract:check": "vitest run tests/contract",
    "repro:check": "node tests/integration/repro-check.ts",
    "docs:reference": "node packages/mcp/src/reference.ts --write",
    "extensions:fetch": "node packages/core/scripts/extensions.ts fetch",
    "extensions:lock": "node packages/core/scripts/extensions.ts lock"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@eslint/js": "^9",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^24.0.0",
    "eslint": "^9",
    "playwright-core": "1.56.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "keytar"
    ]
  }
}
